// RESTOPRO — Multi-Tenant PostgreSQL Schema
// Powered by Prisma ORM

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderType {
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  PENDING_RESTAURANT_CONFIRMATION
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
  DUPLICATE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  ACCEPTED
  UNCERTAIN_DISPATCH
  DELIVERED
  READ
  FAILED
  SUPPRESSED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
  OFFBOARDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMode {
  UPI
  BANK_TRANSFER
  CASH
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

enum SenderChannel {
  RESTAURANT
  CENTRAL
}

model Restaurant {
  id                     String                @id @default(uuid()) @db.Uuid
  name                   String                @db.VarChar(255)
  phone_number_id        String                @unique @db.VarChar(64)
  waba_id                String                @db.VarChar(64)
  owner_phone            String                @db.VarChar(32)
  access_token_encrypted String                @db.Text
  is_active              Boolean               @default(true)
  created_at             DateTime              @default(now()) @db.Timestamptz()
  updated_at             DateTime              @updatedAt @db.Timestamptz()

  // Stage 9: Super Admin Metadata Extensions (all nullable for backward compatibility)
  owner_name             String?               @db.VarChar(255)
  email                  String?               @db.VarChar(255)
  contact_number         String?               @db.VarChar(32)
  address                String?               @db.Text
  internal_notes         String?               @db.Text
  tenant_status          TenantStatus          @default(ACTIVE)

  orders                 Order[]
  sessions               ConversationSession[]
  saved_addresses        SavedAddress[]
  webhook_events         WebhookEvent[]
  notifications          OrderNotification[]
  outbox_messages        OutboxMessage[]
  subscriptions          Subscription[]
  payments               Payment[]

  @@map("restaurants")
}

model Order {
  id                 String              @id @default(uuid()) @db.Uuid
  restaurant_id      String              @db.Uuid
  order_reference    String              @unique @db.VarChar(32)
  confirmation_token String?             @unique @db.VarChar(128)
  customer_name      String?             @db.VarChar(255)
  customer_phone     String              @db.VarChar(32)
  address_snapshot   String?             @db.Text
  latitude           Decimal?            @db.Decimal(10, 7)
  longitude          Decimal?            @db.Decimal(10, 7)
  order_type         OrderType
  items              Json                @db.JsonB
  total_amount       Decimal             @db.Decimal(10, 2)
  currency           String              @default("INR") @db.Char(3)
  status             OrderStatus         @default(PENDING_RESTAURANT_CONFIRMATION)
  decision_at        DateTime?           @db.Timestamptz()
  created_at         DateTime            @default(now()) @db.Timestamptz()
  updated_at         DateTime            @updatedAt @db.Timestamptz()

  restaurant         Restaurant          @relation(fields: [restaurant_id], references: [id], onDelete: Restrict)
  notifications      OrderNotification[]

  @@unique([id, restaurant_id])
  @@index([restaurant_id, status])
  @@index([restaurant_id, customer_phone])
  @@map("orders")
}

model ConversationSession {
  id             String     @id @default(uuid()) @db.Uuid
  restaurant_id  String     @db.Uuid
  customer_phone String     @db.VarChar(32)
  current_step   String     @default("IDLE") @db.VarChar(64)
  state          Json       @default("{}") @db.JsonB
  expires_at     DateTime   @db.Timestamptz()
  created_at     DateTime   @default(now()) @db.Timestamptz()
  updated_at     DateTime   @updatedAt @db.Timestamptz()

  restaurant     Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@unique([restaurant_id, customer_phone])
  @@index([expires_at])
  @@map("conversation_sessions")
}

model SavedAddress {
  id             String     @id @default(uuid()) @db.Uuid
  restaurant_id  String     @db.Uuid
  customer_phone String     @db.VarChar(32)
  label          String?    @default("Default") @db.VarChar(64)
  address        String     @db.Text
  latitude       Decimal?   @db.Decimal(10, 7)
  longitude      Decimal?   @db.Decimal(10, 7)
  created_at     DateTime   @default(now()) @db.Timestamptz()
  updated_at     DateTime   @updatedAt @db.Timestamptz()

  restaurant     Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id, customer_phone])
  @@map("saved_addresses")
}

model WebhookEvent {
  id                String        @id @default(uuid()) @db.Uuid
  restaurant_id     String?       @db.Uuid
  event_key         String        @unique @db.VarChar(128)
  event_type        String        @db.VarChar(32)
  payload_summary   Json?         @db.JsonB
  processing_status WebhookStatus @default(RECEIVED)
  received_at       DateTime      @default(now()) @db.Timestamptz()
  processed_at      DateTime?     @db.Timestamptz()
  claimed_by        String?       @db.VarChar(64)
  lease_token       String?       @db.Uuid
  lease_expires_at  DateTime?     @db.Timestamptz()
  attempt_count     Int           @default(0)

  restaurant        Restaurant?   @relation(fields: [restaurant_id], references: [id], onDelete: SetNull)

  @@index([processing_status])
  @@index([processing_status, lease_expires_at])
  @@map("webhook_events")
}

model OrderNotification {
  id                String             @id @default(uuid()) @db.Uuid
  order_id          String             @db.Uuid
  restaurant_id     String             @db.Uuid
  recipient_phone   String             @db.VarChar(32)
  notification_type String             @db.VarChar(32)
  template_name     String?            @db.VarChar(64)
  delivery_status   NotificationStatus @default(PENDING)
  retry_count       Int                @default(0)
  error_message     String?            @db.Text
  created_at        DateTime           @default(now()) @db.Timestamptz()
  sent_at           DateTime?          @db.Timestamptz()

  order             Order              @relation(fields: [order_id, restaurant_id], references: [id, restaurant_id], onDelete: Cascade)
  restaurant        Restaurant         @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([delivery_status, retry_count])
  @@map("order_notifications")
}

model OutboxMessage {
  id              String        @id @default(uuid()) @db.Uuid
  restaurant_id   String        @db.Uuid
  recipient_phone String        @db.VarChar(32)
  message_type    String        @db.VarChar(32)
  payload         Json          @db.JsonB
  idempotency_key String        @unique @db.VarChar(128)
  status          OutboxStatus  @default(PENDING)
  sender_channel  SenderChannel @default(RESTAURANT)
  attempts        Int           @default(0)
  last_error      String?       @db.Text
  created_at      DateTime      @default(now()) @db.Timestamptz()
  updated_at      DateTime      @updatedAt @db.Timestamptz()

  restaurant      Restaurant    @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([restaurant_id, status])
  @@index([restaurant_id, created_at])
  @@index([sender_channel, status])
  @@map("outbox_messages")
}

// =============================================================================
// STAGE 9: SUPER ADMIN FOUNDATION MODELS
// =============================================================================

model AdminUser {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  password_hash String         @db.VarChar(255)
  role          String         @default("SUPER_ADMIN") @db.VarChar(64)
  is_active     Boolean        @default(true)
  last_login_at DateTime?      @db.Timestamptz()
  created_at    DateTime       @default(now()) @db.Timestamptz()
  updated_at    DateTime       @updatedAt @db.Timestamptz()

  sessions      AdminSession[]
  audit_logs    AuditLog[]
  recorded_payments Payment[]

  @@map("admin_users")
}

model AdminSession {
  id                 String    @id @default(uuid()) @db.Uuid
  admin_id           String    @db.Uuid
  session_token_hash String    @unique @db.VarChar(128)
  ip_address         String?   @db.VarChar(64)
  user_agent         String?   @db.Text
  expires_at         DateTime  @db.Timestamptz()
  created_at         DateTime  @default(now()) @db.Timestamptz()

  admin              AdminUser @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@index([expires_at])
  @@map("admin_sessions")
}

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  restaurant_id String             @db.Uuid
  plan_name     String             @db.VarChar(100)
  amount        Decimal            @db.Decimal(10, 2)
  currency      String             @default("INR") @db.Char(3)
  start_date    DateTime           @db.Timestamptz()
  end_date      DateTime           @db.Timestamptz()
  status        SubscriptionStatus @default(PENDING)
  notes         String?            @db.Text
  created_at    DateTime           @default(now()) @db.Timestamptz()
  updated_at    DateTime           @updatedAt @db.Timestamptz()

  restaurant    Restaurant         @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([restaurant_id, status])
  @@index([status, end_date])
  @@map("subscriptions")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  restaurant_id         String        @db.Uuid
  subscription_id       String?       @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("INR") @db.Char(3)
  payment_date          DateTime      @default(now()) @db.Timestamptz()
  payment_mode          PaymentMode   @default(BANK_TRANSFER)
  transaction_reference String?       @db.VarChar(128)
  status                PaymentStatus @default(RECORDED)
  notes                 String?       @db.Text
  recorded_by_admin_id  String?       @db.Uuid
  original_payment_id   String?       @db.Uuid
  created_at            DateTime      @default(now()) @db.Timestamptz()
  updated_at            DateTime      @updatedAt @db.Timestamptz()

  restaurant            Restaurant    @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  subscription          Subscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  recorded_by           AdminUser?    @relation(fields: [recorded_by_admin_id], references: [id], onDelete: SetNull)
  original_payment      Payment?      @relation("PaymentReversals", fields: [original_payment_id], references: [id], onDelete: SetNull)
  reversals             Payment[]     @relation("PaymentReversals")

  @@index([restaurant_id, payment_date])
  @@index([subscription_id])
  @@index([status])
  @@map("payments")
}

model AuditLog {
  id            String     @id @default(uuid()) @db.Uuid
  admin_user_id String?    @db.Uuid
  action        String     @db.VarChar(128)
  entity_type   String     @db.VarChar(64)
  entity_id     String?    @db.VarChar(128)
  metadata      Json?      @db.JsonB
  created_at    DateTime   @default(now()) @db.Timestamptz()

  admin_user    AdminUser? @relation(fields: [admin_user_id], references: [id], onDelete: SetNull)

  @@index([admin_user_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

// =============================================================================
// R6.5: CENTRAL WHATSAPP ARCHITECTURE
// =============================================================================

model CentralWhatsAppAccount {
  id                     String    @id @default(uuid()) @db.Uuid
  phone_number_id        String    @unique @db.VarChar(64)
  waba_id                String    @db.VarChar(64)
  display_phone_number   String?   @db.VarChar(32)
  access_token_encrypted String    @db.Text
  templates              Json?     @default("{}") @db.JsonB
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now()) @db.Timestamptz()
  updated_at             DateTime  @updatedAt @db.Timestamptz()

  @@index([is_active])
  @@map("central_whatsapp_accounts")
}
