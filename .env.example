# RESTOPRO — Production Environment Configuration Template
# Target: Hostinger KVM 2 VPS (/opt/whatsapp_only)

# Server Settings
PORT=3101
NODE_ENV=production
HOST=127.0.0.1

# Database Settings (Local PostgreSQL 15+ on VPS)
# connection_limit=10 & pool_timeout=20 ensure safe operation within PostgreSQL max_connections=100 under PM2 cluster mode
DATABASE_URL="postgresql://whatsapp_only_user:YOUR_DB_PASSWORD@127.0.0.1:5432/restopro_whatsapp_only?schema=public&connection_limit=10&pool_timeout=20"

# Meta WhatsApp Cloud API Webhook Settings
# META_VERIFY_TOKEN: Custom secret token configured in Meta Developer Dashboard -> WhatsApp -> Configuration
META_VERIFY_TOKEN=YOUR_GENERATED_VERIFY_TOKEN

# META_APP_SECRET: From Meta Developer Dashboard -> App settings -> Basic -> App secret
# Used for HMAC-SHA256 signature verification of incoming webhooks
META_APP_SECRET=YOUR_META_APP_SECRET

# Data-at-Rest Token Encryption (AES-256-GCM)
# REQUIRED in production. 32-byte (64 hex characters) secret key used exclusively to encrypt tenant access tokens.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=YOUR_GENERATED_ENCRYPTION_KEY

# Owner Callback HMAC Signing Key
# REQUIRED in production. 32-byte (64 hex characters) secret key used for signing tamper-resistant Accept/Reject button callbacks.
# Generate with: openssl rand -hex 32
OWNER_CALLBACK_SECRET=YOUR_GENERATED_CALLBACK_SECRET

# Notification Routing Architecture
# NOTIFICATION_ROUTING_MODE: CENTRAL (Meta template notification sent from Central number XYZ to restaurant owner)
NOTIFICATION_ROUTING_MODE=CENTRAL

# Central WhatsApp Business Account Platform Credentials
# Used as fallback when not reading directly from central_whatsapp_accounts PostgreSQL table
CENTRAL_PHONE_NUMBER_ID=106734138803096
CENTRAL_WABA_ID=103820662432290
CENTRAL_ACCESS_TOKEN=YOUR_CENTRAL_META_SYSTEM_USER_ACCESS_TOKEN
