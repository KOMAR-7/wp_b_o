# RESTOPRO — Environment Configuration Template

# Server Settings
PORT=3000
NODE_ENV=development

# Database Settings (PostgreSQL 15+)
# connection_limit=10 & pool_timeout=20 ensure safe operation within PostgreSQL max_connections=100 under PM2 cluster mode
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public&connection_limit=10&pool_timeout=20"

# Meta WhatsApp Cloud API Webhook Settings
# META_VERIFY_TOKEN: Custom secret token you configure in Meta App Dashboard -> WhatsApp -> Configuration
META_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# META_APP_SECRET: From Meta App Dashboard -> App settings -> Basic -> App secret
# Used for HMAC-SHA256 signature verification of incoming webhooks
META_APP_SECRET=your_meta_app_secret_here

# Data-at-Rest Token Encryption (AES-256-GCM)
# REQUIRED in production. Dedicated 32-byte secret (or passphrase) used exclusively to encrypt tenant access tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_secure_32_byte_hex_encryption_key_here

# Owner Callback HMAC Signing Key
# Used for generating tamper-resistant, time-bounded Accept/Reject buttons
OWNER_CALLBACK_SECRET=your_owner_callback_hmac_signing_key_here

# Optional: Outbound Test Number and Token (for testing outbound messages)
# META_PHONE_NUMBER_ID: Test phone number ID provided by Meta
META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN: Temporary or permanent system user access token
META_ACCESS_TOKEN=
