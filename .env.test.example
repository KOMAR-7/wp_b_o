# RESTOPRO — Dedicated Local Test Environment Configuration Template
# Copy this file to .env.test for local automated testing against a dedicated test database.
# STRICT SAFETY: The test loader ONLY permits connection to the local database named "restopro_test".

PORT=3999
NODE_ENV=test

# Database URL pointing STRICTLY to local restopro_test database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/restopro_test?schema=public&connection_limit=5"

# Meta WhatsApp Cloud API Mock/Test Secrets
META_VERIFY_TOKEN=test_mock_webhook_verify_token_2026
META_APP_SECRET=test_mock_meta_app_secret_1234567890abcdef

# Encryption Key (32-byte hex for AES-256-GCM token encryption in tests)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Owner Callback HMAC Signing Key
OWNER_CALLBACK_SECRET=test_owner_callback_signing_secret_9876543210fedcba

# Routing Mode
NOTIFICATION_ROUTING_MODE=CENTRAL

# Central WhatsApp Business Account Mock Settings
CENTRAL_PHONE_NUMBER_ID=106734138803096
CENTRAL_WABA_ID=103820662432290
CENTRAL_ACCESS_TOKEN=EAAB_mock_central_access_token_for_tests

